{
  "name": "claude-usage-dashboard",
  "version": "1.0.0",
  "description": "Claude Code使用量確認Webサービス",
  "main": "server.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server.js",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server.js",
    "test": "vitest run",
    "clean": "rm -rf node_modules build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "express": "^4.21.1",
    "fs-extra": "^11.2.0",
    "glob": "^10.4.5",
    "helmet": "^7.1.0",
    "lodash": "^4.17.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/lodash": "^4.17.19",
    "@types/node": "^24.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "jsdom": "^26.0.0",
    "nodemon": "^3.1.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "claude",
    "usage",
    "dashboard"
  ],
  "author": "",
  "license": "MIT"
}
